# Copy to `.env` for local development (never commit `.env`).

# OpenWeatherMap (required for /api/weather and /api/forecast)
OPENWEATHER_API_KEY=

# Geoapify (required for /api/geo)
GEO_API_KEY=

# Mapbox (optional; required for /api/directions)
MAPBOX_ACCESS_TOKEN=

# Optional: override DB (defaults to SQLite in ./instance/project.db)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional local server
# PORT=5000
# FLASK_DEBUG=true
